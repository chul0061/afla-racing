<Window x:Class="AlfaRacing.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALFA Racing"
        Width="560" Height="780"
        MinWidth="480" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/alfa.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: team logo + name -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="96" Height="75" CornerRadius="10">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="ALFA Racing" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="버튼 하나로 레이스 준비 끝" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Trading Paints warning -->
        <Border x:Name="TradingPaintsBanner"
                Grid.Row="1"
                Margin="0,16,0,0"
                Padding="14,12"
                CornerRadius="12"
                BorderThickness="1"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="⚠ Trading Paints가 설치되어 있지 않아요"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="필수 프로그램이에요. 없으면 다른 드라이버들의 페인트가 안 보여요."
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="설치하기"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnInstallTradingPaintsClick" />
            </Grid>
        </Border>

        <!-- Start / stop -->
        <Grid Grid.Row="2" Margin="0,20,0,0" Height="124">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="StartButton"
                    Style="{StaticResource BigActionButton}"
                    Background="{StaticResource StartBrush}"
                    ToolTip="시작 목록의 프로그램을 위에서부터 순서대로 켜요"
                    Click="OnStartClick">
                <StackPanel>
                    <TextBlock Text="▶" FontSize="28" HorizontalAlignment="Center" />
                    <TextBlock Text="시작" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Text="모두 켜기" FontSize="12" Opacity="0.85" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton"
                    Grid.Column="2"
                    Style="{StaticResource BigActionButton}"
                    Background="{StaticResource StopBrush}"
                    ToolTip="켠 순서의 반대로 모두 꺼요"
                    Click="OnStopClick">
                <StackPanel>
                    <TextBlock Text="■" FontSize="28" HorizontalAlignment="Center" />
                    <TextBlock Text="종료" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock Text="모두 끄기" FontSize="12" Opacity="0.85" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Progress / last result -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="16,12" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="준비됐어요" TextWrapping="Wrap" />
                <ProgressBar x:Name="BusyBar"
                             Height="4"
                             Margin="0,10,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Start list with live status -->
        <Border Grid.Row="4" Margin="0,16,0,0" Padding="0" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="16,14,16,6">
                    <TextBlock x:Name="ListCountText"
                               DockPanel.Dock="Right"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="시작 목록" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StatusList" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,9" Background="Transparent" ToolTip="{Binding ToolTipText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusBrush}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState"
                            Grid.Row="1"
                            Margin="24"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="시작 목록이 비어 있어요" HorizontalAlignment="Center" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="설치된 레이싱 프로그램을 자동으로 찾아서 넣을 수 있어요."
                               Style="{StaticResource MutedText}"
                               TextAlignment="Center"
                               Margin="0,6,0,14" />
                    <Button Content="자동으로 찾기" HorizontalAlignment="Center" Click="OnAutoDetectClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="⚙  설정" Click="OnSettingsClick" />
            <Button DockPanel.Dock="Left" Content="추천 프로그램" Margin="8,0,0,0" Click="OnRecommendedClick" />
            <TextBlock x:Name="VersionText"
                       DockPanel.Dock="Right"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
