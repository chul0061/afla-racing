<Window x:Class="AlfaRacing.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정"
        Width="900" Height="680"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/alfa.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">

            <!-- 1. Start list -->
            <TabItem Header="시작 목록">
                <Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="2"
                               Style="{StaticResource MutedText}"
                               Text="위에서부터 순서대로 켜져요. 종료할 땐 반대 순서로 꺼져요. 줄을 두 번 누르면 편집할 수 있어요." />

                    <ListBox x:Name="StartList"
                             Grid.Row="1"
                             Margin="0,12,0,0"
                             SelectionMode="Single"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnStartListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}"
                                              Content="사용"
                                              MinWidth="0"
                                              VerticalAlignment="Center"
                                              ToolTip="체크를 끄면 시작 버튼을 눌러도 켜지지 않아요" />
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PathText}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PathText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DelayText}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="3"
                                              IsChecked="{Binding StopOnExit}"
                                              Content="종료 시 끄기"
                                              MinWidth="0"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              ToolTip="체크하면 종료 버튼을 누를 때 같이 꺼요" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Grid.Column="1" Width="250" Margin="12,12,0,0">
                        <Button Content="프로그램 추가..." HorizontalAlignment="Stretch" Click="OnAddProgramClick" />
                        <Button Content="실행 중인 프로그램에서 추가..." HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnAddFromRunningClick" />
                        <Button Content="추천 프로그램에서 추가" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnGoToRecommendedClick" />
                        <Separator Margin="0,14" />
                        <Button Content="편집..." HorizontalAlignment="Stretch" Click="OnEditClick" />
                        <Button Content="삭제" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnRemoveClick" />
                        <Separator Margin="0,14" />
                        <Button Content="▲ 위로" HorizontalAlignment="Stretch" Click="OnMoveUpClick" />
                        <Button Content="▼ 아래로" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnMoveDownClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 2. Stop -->
            <TabItem Header="종료">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,12,4" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="종료 순서" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0"
                                   Text="종료 버튼을 누르면 시작 목록에서 '종료 시 끄기'가 체크된 프로그램을 켠 순서의 반대로 꺼요. 먼저 창을 닫아 정상 종료를 요청하고, 안 꺼지면 강제로 종료해요." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="정상 종료 대기 시간" Margin="0,24,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox x:Name="ForceKillCombo" Width="100" />
                            <TextBlock Text="초 기다린 뒤 강제 종료" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="ConfirmDrivingCheck"
                                  Margin="0,20,0,0"
                                  Content="iRacing 주행 중이면 종료 전에 한 번 더 물어보기" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="추가로 끌 프로그램" Margin="0,24,0,0" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0"
                                   Text="시작 목록에 없는 프로그램도 같이 끌 수 있어요. 작업 관리자 '세부 정보' 탭에 보이는 이름을 .exe 없이 적어 주세요. 끝에 *를 붙이면 앞부분만 같아도 꺼요." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExtraProcessInput" KeyDown="OnExtraProcessKeyDown" />
                            <Button Grid.Column="1" Content="추가" Margin="8,0,0,0" Click="OnAddExtraProcessClick" />
                            <Button Grid.Column="2" Content="실행 중에서 고르기..." Margin="8,0,0,0" Click="OnPickExtraProcessClick" />
                        </Grid>
                        <ListBox x:Name="ExtraProcessList" Height="150" Margin="0,8,0,0" />
                        <Button Content="선택한 항목 삭제" Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnRemoveExtraProcessClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Recommended programs -->
            <TabItem Header="추천 프로그램">
                <Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button x:Name="RescanButton" DockPanel.Dock="Right" Content="다시 찾기" Click="OnRescanClick" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="같이 쓰면 좋은 프로그램들이에요. 설치되어 있으면 바로 시작 목록에 넣을 수 있어요." />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CatalogList" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource BadgeBorder}" Background="{Binding CategoryBrush}">
                                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontSize="12"
                                                           Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StatusText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Width="150" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <Button Content="{Binding AddButtonText}"
                                                        IsEnabled="{Binding CanAdd}"
                                                        HorizontalAlignment="Stretch"
                                                        Click="OnAddCatalogClick" />
                                                <Button Content="{Binding WebsiteButtonText}"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,8,0,0"
                                                        Click="OnCatalogWebsiteClick" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 4. General -->
            <TabItem Header="일반">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,12,4">
                        <CheckBox x:Name="RunOnStartupCheck" Content="Windows를 켤 때 자동 실행" />
                        <CheckBox x:Name="MinimizeAfterStartCheck" Margin="0,12,0,0" Content="시작이 끝나면 창 최소화" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="자동 설정" Margin="0,28,0,0" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0"
                                   Text="설치된 프로그램을 다시 찾아서, 시작 목록에 없는 것을 추가해요." />
                        <Button Content="설치된 프로그램 다시 찾기..." HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnRunSetupAgainClick" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="파일" Margin="0,28,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="설정 폴더 열기" Click="OnOpenDataFolderClick" />
                            <Button Content="로그 폴더 열기" Margin="8,0,0,0" Click="OnOpenLogFolderClick" />
                        </StackPanel>

                        <TextBlock x:Name="AboutText" Style="{StaticResource MutedText}" Margin="0,28,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="저장" IsDefault="True" MinWidth="96" Click="OnSaveClick" />
            <Button Content="취소" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
