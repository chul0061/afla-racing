<Window x:Class="AflaRacing.App.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실행 중인 프로그램"
        Width="720" Height="580"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/afla.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource MutedText}"
                   Text="추가할 프로그램을 먼저 켜 두고 여기서 골라 주세요. 창이 있는 프로그램이 위에 보여요." />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="OnSearchChanged" />
        </Grid>

        <ListBox x:Name="AppList"
                 Grid.Row="2"
                 Margin="0,12,0,0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,3">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  " />
                            <Run Text="{Binding ProcessName, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                        </TextBlock>
                        <TextBlock Text="{Binding ExecutablePath}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ExecutablePath}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="LoadingText"
                   Grid.Row="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource MutedText}"
                   Text="실행 중인 프로그램을 읽는 중..." />

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="새로 고침" Click="OnRefreshClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="선택" IsDefault="True" MinWidth="96" Click="OnSelectClick" />
                <Button Content="취소" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
