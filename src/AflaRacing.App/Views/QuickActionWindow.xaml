<Window x:Class="AflaRacing.App.Views.QuickActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFLA Racing"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Icon="/Assets/afla.ico"
        Background="{StaticResource CardBrush}"
        BorderBrush="{StaticResource CardBorderBrush}"
        BorderThickness="1"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontSize="14"
        MouseLeftButtonDown="OnDragWindow">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Top">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <TextBlock x:Name="TitleText" Text="AFLA Racing" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailText" Text="준비 중..." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" IsIndeterminate="True" />
            <TextBlock x:Name="ProblemsText"
                       Margin="0,10,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource WarningTextBrush}"
                       Visibility="Collapsed" />
            <StackPanel x:Name="ButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                <Button x:Name="OpenAppButton" Content="AFLA Racing 열기" Click="OnOpenAppClick" />
                <Button Content="닫기" MinWidth="72" Margin="8,0,0,0" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
