<Window x:Class="AflaRacing.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자동 설정"
        Width="700" Height="700"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/afla.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="77" Height="60" CornerRadius="8">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="WelcomeText" Text="환영해요" FontSize="22" FontWeight="Bold" />
                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,4,0,0"
                           Text="설치된 레이싱 프로그램을 찾아서 시작 목록을 만들어 드릴게요." />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="SearchStatusText"
                   Grid.Row="1"
                   Margin="0,20,0,0"
                   TextWrapping="Wrap"
                   Text="설치된 프로그램을 찾는 중..." />

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultList" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}"
                                          IsEnabled="{Binding IsInstalled}"
                                          MinWidth="0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource BadgeBorder}" Background="{Binding CategoryBrush}">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{Binding StatusBrush}"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StatusText}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="다운로드"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVisibility}}"
                                        Click="OnDownloadClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="TradingPaintsWarning"
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="14,10"
                CornerRadius="10"
                BorderThickness="1"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource WarningTextBrush}"
                       TextWrapping="Wrap"
                       Text="⚠ Trading Paints는 꼭 설치해야 해요. 설치한 뒤 [다시 찾기]를 눌러 주세요." />
        </Border>

        <CheckBox x:Name="ShortcutCheck"
                  Grid.Row="4"
                  Margin="0,14,0,0"
                  IsChecked="True"
                  Content="바탕화면에 시작·종료 바로가기도 만들기 (창을 열지 않고 더블클릭으로 켜고 끄기)" />

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <Button x:Name="RescanButton" DockPanel.Dock="Left" Content="다시 찾기" Click="OnRescanClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="건너뛰기" IsCancel="True" MinWidth="96" />
                <Button x:Name="ConfirmButton"
                        Content="시작 목록 만들기"
                        IsDefault="True"
                        MinWidth="140"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="OnConfirmClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
